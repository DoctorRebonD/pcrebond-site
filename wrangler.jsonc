{
  "name": "pcrebond-site",
  "main": "worker.js",
  "compatibility_date": "2026-08-30",
  "assets": { "directory": ".", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/media/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "pcrebond-data", "database_id": "A_REMPLACER_APRES_CREATION_D1" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "pcrebond-media" }]
}
